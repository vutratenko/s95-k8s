# Apply manually if the repo is private and Argo needs credentials.
apiVersion: v1
kind: Secret
metadata:
  name: s95-k8s-repo
  namespace: shturval-cd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: https://github.com/vutratenko/s95-k8s.git
  username: git
  password: REPLACE_WITH_GITHUB_PAT
